---
/**
 * Renders the game listing and applies category and publisher filters from the
 * URL while preserving client-side filtering for the prerendered site.
 */

import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories } from '../lib/categories';
import { getFilteredGames } from '../lib/games';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const database = getDatabase();
const selectedCategoryIds = Astro.url.searchParams
  .getAll('category')
  .map(Number)
  .filter((id) => Number.isInteger(id) && id > 0);
const publisherParam = Astro.url.searchParams.get('publisher');
const selectedPublisherId =
  publisherParam && Number.isInteger(Number(publisherParam)) && Number(publisherParam) > 0
    ? Number(publisherParam)
    : undefined;
const [categories, publishers, games] = await Promise.all([
  getAllCategories(database),
  getAllPublishers(database),
  getFilteredGames(database, {
    categoryIds: selectedCategoryIds,
    publisherId: selectedPublisherId,
  }),
]);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      <form
        method="get"
        action="/"
        aria-label="Filter games"
        class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-6"
        data-testid="game-filters"
      >
        <div class="grid gap-6 md:grid-cols-2">
          <fieldset>
            <legend class="mb-3 text-lg font-medium text-slate-100">Categories</legend>
            <div class="grid gap-3 sm:grid-cols-2">
              {categories.map((category) => (
                <label class="flex items-center gap-2 text-slate-300">
                  <input
                    type="checkbox"
                    name="category"
                    value={category.id}
                    checked={selectedCategoryIds.includes(category.id)}
                    class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500"
                    data-testid={`category-filter-${category.id}`}
                  />
                  <span>{category.name}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <div>
            <label for="publisher-filter" class="mb-3 block text-lg font-medium text-slate-100">
              Publisher
            </label>
            <select
              id="publisher-filter"
              name="publisher"
              class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              data-testid="publisher-filter"
            >
              <option value="">All publishers</option>
              {publishers.map((publisher) => (
                <option value={publisher.id} selected={selectedPublisherId === publisher.id}>
                  {publisher.name}
                </option>
              ))}
            </select>
          </div>
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-4">
          <button
            type="submit"
            class="rounded-lg bg-blue-600 px-4 py-2 font-medium text-white transition-colors hover:bg-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            data-testid="apply-filters"
          >
            Apply filters
          </button>
          <a
            href="/"
            class="rounded-lg border border-slate-600 px-4 py-2 font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            data-testid="clear-filters"
          >
            Clear filters
          </a>
        </div>
      </form>

      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
        data-testid="games-grid"
        hidden={games.length === 0}
      >
        {games.map((game) => <GameCard game={game} />)}
      </div>
      <div data-testid="empty-state" hidden={games.length > 0}>
        <EmptyState text="No games match the selected filters." />
      </div>
    </div>
  </div>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
  const grid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="empty-state"]');
  const categoryInputs = Array.from(
    document.querySelectorAll<HTMLInputElement>('input[name="category"]'),
  );
  const publisherSelect = document.querySelector<HTMLSelectElement>('select[name="publisher"]');

  const applyFilters = (): void => {
    const params = new URLSearchParams(window.location.search);
    const selectedCategories = new Set(params.getAll('category'));
    const selectedPublisher = params.get('publisher');

    categoryInputs.forEach((input) => {
      input.checked = selectedCategories.has(input.value);
    });

    if (publisherSelect) {
      publisherSelect.value = selectedPublisher ?? '';
    }

    const visibleCards = cards.filter((card) => {
      const categoryMatches =
        selectedCategories.size === 0 || selectedCategories.has(card.dataset.categoryId ?? '');
      const publisherMatches =
        !selectedPublisher || card.dataset.publisherId === selectedPublisher;
      const visible = categoryMatches && publisherMatches;
      card.hidden = !visible;
      return visible;
    });

    if (grid && emptyState) {
      grid.hidden = visibleCards.length === 0;
      emptyState.hidden = visibleCards.length > 0;
    }
  };

  form?.addEventListener('submit', () => {
    categoryInputs.forEach((input) => {
      input.disabled = !input.checked;
    });
  });

  applyFilters();
</script>
